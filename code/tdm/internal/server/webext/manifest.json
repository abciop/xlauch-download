{
  "manifest_version": 3,
  "name": "XDM 下载器助手",
  "version": "1.0.0",
  "description": "右键发送下载到 Xlauch 下载器 / 嗅探页面媒体资源 / 一键导出当前站点登录 Cookie",
  "permissions": [
    "contextMenus",
    "cookies",
    "webRequest",
    "storage",
    "activeTab",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XDM 下载器助手",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
